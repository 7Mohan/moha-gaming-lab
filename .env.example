# ────────────────────────────────────────────────────────────────
# Moha Gaming Lab — Production Environment Variables Template
# Copy this file to .env.local and configure for your environment.
# ────────────────────────────────────────────────────────────────

# ================================================================
# 1. PUBLIC CONFIGURATION (Safe to expose to browser / client bundles)
# ================================================================

# Canonical site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Public Endpoint (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Publishable Key (Safe for browser; protected by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"


# ================================================================
# 2. SERVER-ONLY SECRETS (STRICTLY CONFIDENTIAL — NEVER EXPOSE TO CLIENT)
# ================================================================

# Supabase Service Role Secret (Bypasses RLS; used solely for server-side admin user management)
# WARNING: DO NOT prefix with NEXT_PUBLIC_ or commit to version control.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Secret token used for signing session cookies and internal admin mutations
# Minimum 32 random characters recommended for production.
ADMIN_SECRET="change-this-to-a-secure-random-token-in-production-min-32-chars"

# Sole designated SuperAdmin email
ADMIN_EMAIL="4mohabashir@gmail.com"


# ================================================================
# 3. DATABASE CONFIGURATION (Server-Side Only)
# ================================================================

# PostgreSQL connection string (Supabase Postgres, Neon, or local Docker)
# Used by Prisma ORM for persistent data layer
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?sslmode=require"


# ================================================================
# 4. BREVO CONFIGURATION (Server-Side Only - Transactional Emails)
# ================================================================

# Brevo v3 REST API Key (Settings → SMTP & API → API Keys)
BREVO_API_KEY="xkeysib-your-brevo-api-key"

# Verified sender email address in Brevo
BREVO_SENDER_EMAIL="4mohabashir@gmail.com"
BREVO_SENDER_NAME="Moha Gaming Lab"


# ================================================================
# 5. STORAGE & DOWNLOAD CONFIGURATION (Phase 12 Real Infrastructure)
# ================================================================

# Supabase Storage private bucket for hosted APK packages (default: app-releases)
SUPABASE_STORAGE_BUCKET="app-releases"

# Configurable maximum APK release upload size in bytes (default: 100MB = 104857600)
MAX_APP_RELEASE_SIZE="104857600"

