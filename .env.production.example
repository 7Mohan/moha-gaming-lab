# ────────────────────────────────────────────────────────────────
# Moha Gaming Lab — Production Environment Variables Reference
# Copy this file to your hosting platform's Environment Secrets.
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT.
# ────────────────────────────────────────────────────────────────

# ================================================================
# 1. CORE APPLICATION RUNTIME
# ================================================================
NODE_ENV="production"
PORT=3000

# Canonical public production URL (Strictly HTTPS in production)
NEXT_PUBLIC_SITE_URL="https://mohagaminglab.com"

# ================================================================
# 2. EMERGENCY OPERATIONAL SWITCHES (Zero-downtime feature control)
# ================================================================
# Set to "true" to put the site into Maintenance Mode (returns 503 to visitors; bypasses /admin & /api/health)
MAINTENANCE_MODE="false"

# Global killswitch for artifact downloads ("true" / "false")
NEXT_PUBLIC_DOWNLOADS_ENABLED="true"

# Global killswitch for display ads ("true" / "false")
NEXT_PUBLIC_ADS_ENABLED="true"

# Global killswitch for client-side telemetry/analytics ("true" / "false")
NEXT_PUBLIC_ANALYTICS_ENABLED="true"

# ================================================================
# 3. SUPABASE INFRASTRUCTURE (Database, Auth, Storage)
# ================================================================
# Supabase Project API URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Publishable Key (Client safe; enforced by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER ONLY — Bypasses RLS for admin actions)
# CRITICAL: Keep strictly secret. Never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Storage bucket name for hosted APK/IPA releases (Private bucket)
SUPABASE_STORAGE_BUCKET="app-releases"

# Maximum upload file size in bytes (100MB = 104857600)
MAX_APP_RELEASE_SIZE="104857600"

# ================================================================
# 4. DATABASE CONNECTION POOLING (Prisma ORM)
# ================================================================
# Pooled connection string (Supabase Transaction Pooler / PgBouncer on port 6543)
# Recommended for serverless deployments to prevent connection exhaustion.
DATABASE_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection string (Supabase Session Pooler or direct on port 5432)
# Required for running Prisma migrations (prisma migrate deploy)
DIRECT_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ================================================================
# 5. SECURITY & ADMIN CREDENTIALS
# ================================================================
# Dedicated SuperAdmin email address
ADMIN_EMAIL="4mohabashir@gmail.com"

# High-entropy cryptographic secret for signing admin sessions & mutations (min 32 chars)
ADMIN_SECRET="generate-a-64-character-hex-or-base64-random-string-here"

# ================================================================
# 6. TRANSACTIONAL EMAIL (Brevo / Sendinblue)
# ================================================================
BREVO_API_KEY="xkeysib-your-production-brevo-v3-api-key"
BREVO_SENDER_EMAIL="4mohabashir@gmail.com"
BREVO_SENDER_NAME="Moha Gaming Lab"

# ================================================================
# 7. OBSERVABILITY, LOGGING & MONITORING
# ================================================================
# Logging level: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL="info"

# Sentry DSN (Optional — if integrating Sentry for real-time error tracking)
# NEXT_PUBLIC_SENTRY_DSN="https://key@o0.ingest.sentry.io/0"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ================================================================
# 8. MONETIZATION & ADSENSE (Phase 13 Architecture)
# ================================================================
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

# ================================================================
# 9. ANALYTICS & GROWTH (Phase 14 Architecture)
# ================================================================
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
