{
  "name": "moha-gaming-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "build": "prisma generate --schema=./prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:backend": "node --test tests/validation.test.mjs tests/services.test.mjs",
    "test:security": "node --test tests/security-rbac.test.mjs",
    "test:download": "node --test tests/download-infrastructure.test.mjs",
    "test:all": "node --test tests/validation.test.mjs tests/services.test.mjs tests/security-rbac.test.mjs tests/download-infrastructure.test.mjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.10",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "gsap": "^3.12.5",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8",
    "prisma": "^7.10.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "overrides": {
    "three-mesh-bvh": "^0.8.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
